# EduShield 校园智盾（大脑）— 环境配置
# 复制此文件为 .env 并填入实际值

# DeepSeek API（阶段 2/3 判定与报告使用）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.3

# ChromaDB（阶段 2 知识库使用）
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=edushield_knowledge

# 大脑服务（端口 6657，aisoc-docs 01）
API_HOST=0.0.0.0
API_PORT=6657
LOG_LEVEL=INFO

# SQLite 会话存储
BRAIN_DB_PATH=./data/brain.sqlite3

# 部件注册表（留空 = 用内置默认：pentest 8787 / logaudit 8788）
# 也可指向 JSON：{"pentest": {"host": "127.0.0.1", "port": 8787, "token": "..."}}
REGISTRY_FILE=

# 授权白名单（逗号分隔；不在名单内的 target 一律拒绝）
TARGET_WHITELIST_ENABLED=true
AUTHORIZED_TARGETS=127.0.0.1,10.21.16.116,demo-campus.edu.cn,http://demo-campus.edu.cn

# 部件下发（HTTP）
PART_SUBMIT_TIMEOUT_S=10
PART_TURN_TIMEOUT_S=600
PART_POLL_INTERVAL_S=0.5
PART_POLL_MAX_ATTEMPTS=60

# 深信服 XDR 数据接入（阶段 2；不配则用官方样例数据离线跑）
XDR_LIVE_ENABLED=false
XDR_BASE_URL=
XDR_AUTH_CODE=
XDR_AK=
XDR_SK=
XDR_SAMPLE_FILE=./data/samples/xdr_alerts_sample.json

# 应急响应子 Agent（TIR，端口 8090）
TIR_ENABLED=true
TIR_BASE_URL=http://127.0.0.1:8090
