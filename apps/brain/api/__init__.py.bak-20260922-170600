@app.get("/api/stream")
async def stream():
    """实时事件流（SSE）—— 前端实时面板数据源。"""
    hub = get_hub()
    q = hub.subscribe()

    async def gen():
        try:
            while True:
                try:
                    event = await asyncio.to_thread(q.get, timeout=15)
                    yield f"data: {json.dumps(event, ensure_ascii=False)}\n\n"
                except Exception:
                    yield ": ping\n\n"
        finally:
            hub.unsubscribe(q)

    return StreamingResponse(gen(), media_type="text/event-stream")


