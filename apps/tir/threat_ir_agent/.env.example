# 威胁警报-应急响应 子Agent 环境变量模板（全部 TIR_ 前缀，与 edushield 隔离）
# 复制为 .env 后按需修改；不修改 edushield 的 .env

# ---- 推理大脑（DeepSeek-Reasonix-Security 模型网关）----
# auto | reasonix-cli | openai-api | mock
TIR_MODEL_GATEWAY=auto
# reasonix CLI 通道：DeepSeek-Reasonix-Security 二进制路径（默认取 PATH 中的 reasonix）
#TIR_REASONIX_BIN=reasonix
#TIR_REASONIX_TIMEOUT_SECONDS=180

# openai-api 通道（与 edushield llm 适配层同源；不填则只读回退 edushield/.env）
#DEEPSEEK_API_KEY=sk-xxx
#DEEPSEEK_API_BASE=https://api.deepseek.com/v1
#DEEPSEEK_MODEL=deepseek-chat
#TIR_LLM_TEMPERATURE=0.2
#TIR_CLASSIFY_TEMPERATURE=0.1        # 威胁分级专用温度（更低→研判更稳定可复现）
#TIR_API_TIMEOUT_SECONDS=120

# ---- 本地持久化（子Agent专属存储，默认在包内 storage/data）----
#TIR_STORE_DIR=./storage/data
#TIR_RETENTION_DAYS=180

# ---- 告警异步推送（可选；由 edushield 部署方提供桥接端点）----
#TIR_NOTIFY_URL=http://localhost:8000/api/notify/threat-alert
#TIR_NOTIFY_TIMEOUT_SECONDS=10

# ---- 子Agent HTTP 服务 ----
#TIR_API_HOST=127.0.0.1
#TIR_API_PORT=8090
