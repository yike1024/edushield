root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ---- 各模块保持自己技术栈的原始风格，不要全仓统一 ----
[*.py]
indent_size = 4
max_line_length = 120

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{ps1,psm1}]
indent_size = 4
end_of_line = crlf

[*.sh]
end_of_line = lf

# -- Windows 上编辑批处理别改行尾
[*.{bat,cmd}]
end_of_line = crlf
