# ============================================================================
# 日志审计域（logaudit：reasonix serve 直连 8788，带 log_ingest/anomaly_detect/correlation）
# 端口必须与 config/services.json 的 logaudit-serve 一致
# ============================================================================
LOGAUDIT_PORT=8788

# serve 鉴权 token（Cookie: reasonix_token / ?token=）
REASONIX_SERVE_TOKEN=${LOGAUDIT_SERVE_TOKEN}
# 大脑 registry 里 logaudit 的 token（registry 中 auth=cookie，值同 LOGAUDIT_PART_TOKEN）
BRAIN_TOKEN=${LOGAUDIT_PART_TOKEN}

# ---- reasonix serve 运行环境 ----
REASONIX_HOME=./.serve-home
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
DEEPSEEK_API_BASE=${DEEPSEEK_API_BASE}
DEEPSEEK_MODEL=${DEEPSEEK_MODEL}
HTTP_PROXY=${HTTP_PROXY}
HTTPS_PROXY=${HTTPS_PROXY}
NO_PROXY=${NO_PROXY}

# ---- 审计工作目录（日志落盘 / 分片保留）----
LOG_AUDIT_WORKDIR=./logaudit-workdir
LOG_AUDIT_RETENTION_DAYS=90
