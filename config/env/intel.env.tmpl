# ============================================================================
# 情报收集域（intel：adapter 8789 → reasonix serve 8089）
# 端口必须与 config/services.json 的 intel-* 一致
# ============================================================================
ADAPTER_PORT=8789
RIX_PORT=8089

RIX_TOKEN=${INTEL_SERVE_TOKEN}
BRAIN_TOKEN=${INTEL_PART_TOKEN}
BRAIN_TOKEN_LEGACY=

# ---- reasonix serve 运行环境 ----
REASONIX_HOME=./.reasonix-home
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
DEEPSEEK_API_BASE=${DEEPSEEK_API_BASE}
DEEPSEEK_MODEL=${DEEPSEEK_MODEL}
HTTP_PROXY=${HTTP_PROXY}
HTTPS_PROXY=${HTTPS_PROXY}
NO_PROXY=${NO_PROXY}

# ---- adapter 运行参数（改造后由 adapter.py 读取）----
ADAPTER_LOG_DIR=../../../logs
STALL_LIMIT=300
MAX_RETRIES=2
