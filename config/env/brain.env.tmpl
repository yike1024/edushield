# ============================================================================
# 大脑（brain / FastAPI 6657）
# 端口必须与 config/services.json 的 brain.port 一致
# ============================================================================
API_HOST=127.0.0.1
API_PORT=6657
LOG_LEVEL=INFO

# ---- 会话 / 附件 / 账号存储 ----
BRAIN_DB_PATH=./data/brain.sqlite3
BRAIN_ATTACHMENT_DIR=./data/attachments
# 生产用 PostgreSQL 时填；留空回退 SQLite
DATABASE_URL=

# ---- LLM（判定双轨 + 报告生成）----
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
DEEPSEEK_API_BASE=${DEEPSEEK_API_BASE}
DEEPSEEK_MODEL=${DEEPSEEK_MODEL}
LLM_TEMPERATURE=0.3

# ---- 知识库 ----
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=edushield_knowledge

# ---- 部件注册表（cwd = apps/brain，故用相对路径）----
REGISTRY_FILE=../../config/registry/brain.registry.json

# ---- 授权白名单（不在名单内的 target 一律拒绝）----
TARGET_WHITELIST_ENABLED=true
AUTHORIZED_TARGETS=127.0.0.1,10.21.16.116,demo-campus.edu.cn,http://demo-campus.edu.cn

# ---- 部件下发 / 回收 ----
PART_SUBMIT_TIMEOUT_S=10
PART_TURN_TIMEOUT_S=1800
PART_POLL_INTERVAL_S=0.5
PART_POLL_MAX_ATTEMPTS=60

# ---- 应急响应子 Agent（TIR）----
TIR_ENABLED=true
TIR_BASE_URL=http://127.0.0.1:8090

# ---- 深信服 XDR（不配则用离线样例）----
XDR_LIVE_ENABLED=false
XDR_BASE_URL=
XDR_AUTH_CODE=
XDR_AK=
XDR_SK=
XDR_SAMPLE_FILE=./data/samples/xdr_alerts_sample.json

# ---- 认证（15 号契约）----
AUTH_SESSION_TTL_DAYS=7
AUTH_BCRYPT_ROUNDS=12
