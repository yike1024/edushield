# ============================================================================
# 威胁警报 / 应急响应子 Agent（tir / FastAPI 8090）
# 端口必须与 config/services.json 的 tir.port 一致
# ============================================================================
TIR_MODEL_GATEWAY=auto
TIR_API_HOST=127.0.0.1
TIR_API_PORT=8090

# ---- 推理通道 ----
TIR_REASONIX_BIN=${REASONIX_BIN}
TIR_REASONIX_TIMEOUT_SECONDS=180
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
DEEPSEEK_API_BASE=${DEEPSEEK_API_BASE}
DEEPSEEK_MODEL=${DEEPSEEK_MODEL}
TIR_LLM_TEMPERATURE=0.2
TIR_CLASSIFY_TEMPERATURE=0.1
TIR_API_TIMEOUT_SECONDS=120

# ---- 本地持久化（子 Agent 专属，不碰大脑/ChromaDB）----
TIR_STORE_DIR=./storage/data
TIR_LOG_DIR=./storage/logs
TIR_RETENTION_DAYS=180

# ---- 告警异步推送（留空 = 只在同步响应里返回）----
TIR_NOTIFY_URL=
TIR_NOTIFY_TIMEOUT_SECONDS=10
