# ============================================================================
# 全仓共享变量 —— scripts/gen-env.* 会把它复制为 config/env/shared.env（该文件不进 git）
# 再用它展开 config/env/*.env.tmpl 里的 ${VAR}
#
# 这里的值都是**占位符**（xxxx），不是真实凭据：默认不随机生成、也不预置真值。
#   - 想跑起来：把 sk-xxxx 换成真实值（API key 与 token 各 >=16 字符）
#   - 换完重跑 gen-env，不要在各模块 .env 里手改（会被覆盖）
#   - 也可以只改本地 config/env/shared.env（不进 git），.example 保持占位符不动
# ============================================================================

# ---- 模型通道（大脑判定 + 三个 reasonix 域 + TIR 共用）----
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- reasonix 可执行文件 ----
# Linux/macOS 保持 ./bin/reasonix；Windows 改成 bin\reasonix.exe 或绝对路径
REASONIX_BIN=./bin/reasonix

# ---- 部件 token ----
# 每个域一对：
#   <域>_SERVE_TOKEN  adapter ↔ reasonix serve 的 Cookie（reasonix --token）
#   <域>_PART_TOKEN   大脑 registry → adapter 的 Bearer（两侧必须一致）
# 三个域可以各填各的（推荐，便于分域隔离），也可以共用一个值。
# 仍是 sk-xxxx 时：adapter 的 AI 审批门会自动跳过（不会因 401 把所有敏感命令拒掉）。
PENTEST_SERVE_TOKEN=sk-xxxx
PENTEST_PART_TOKEN=sk-xxxx
LOGAUDIT_SERVE_TOKEN=sk-xxxx
LOGAUDIT_PART_TOKEN=sk-xxxx
INTEL_SERVE_TOKEN=sk-xxxx
INTEL_PART_TOKEN=sk-xxxx

# ---- 出网代理（reasonix serve 拉模型/情报源时用；不需要就留空）----
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
