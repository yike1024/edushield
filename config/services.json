{
  "$schema-note": "全仓唯一事实来源：端口、启动命令、健康检查、依赖顺序、环境注入。改端口/新增模块只改这里 + config/env/<id>.env.tmpl。",
  "version": 2,
  "project": "edushield-platform",
  "bind": "127.0.0.1",
  "runDir": ".run",
  "logDir": "logs",
  "groups": {
    "brain": { "desc": "大脑编排层（FastAPI 6657）", "owner": "@linyuxuan" },
    "pentest": { "desc": "渗透验证域：adapter 8786 → reasonix serve 4523", "owner": "@wangwei" },
    "logaudit": { "desc": "日志审计域：reasonix serve 8788（serve 直连）", "owner": "@linchen" },
    "intel": { "desc": "情报收集域：adapter 8789 → reasonix serve 8089", "owner": "@wangwei" },
    "tir": { "desc": "威胁警报/应急响应子 Agent（FastAPI 8090）", "owner": "@chenyiming" },
    "frontend": { "desc": "桌面/Web 前端 + 静态代理（3000 / dev 5173）", "owner": "@linyuxuan" }
  },
  "services": [
    {
      "id": "tir",
      "group": "tir",
      "role": "part",
      "kind": "http",
      "cwd": "apps/tir",
      "cmd": ["python", "-m", "threat_ir_agent", "serve", "--host", "127.0.0.1", "--port", "${TIR_API_PORT}"],
      "envFile": "config/env/tir.env",
      "port": 8090,
      "baseUrl": "http://127.0.0.1:8090",
      "health": { "path": "/api/tir/health", "expect": 200, "auth": "none" },
      "dependsOn": [],
      "startOrder": 10,
      "enabled": true,
      "notes": "大脑 6657 与前端统一经 TIR_BASE_URL 访问；纯本地子 Agent，无 token。"
    },
    {
      "id": "pentest-serve",
      "group": "pentest",
      "role": "engine",
      "kind": "http",
      "cwd": "apps/pentest",
      "cmd": ["${REASONIX_BIN}", "serve", "--addr", "127.0.0.1:${PENTEST_RIX_PORT}", "--auth", "token", "--token", "${PENTEST_SERVE_TOKEN}"],
      "envFile": "config/env/pentest.env",
      "extraEnvFiles": ["apps/pentest/.reasonix-home/.env"],
      "port": 4523,
      "baseUrl": "http://127.0.0.1:4523",
      "health": { "path": "/status", "expect": 200, "auth": "cookie", "cookieName": "reasonix_token", "cookieVar": "PENTEST_SERVE_TOKEN" },
      "postStart": { "path": "/tool-approval-mode", "method": "POST", "cookieVar": "PENTEST_SERVE_TOKEN", "body": { "mode": "auto" } },
      "preflightFiles": ["./bin/reasonix"],
      "dependsOn": [],
      "startOrder": 20,
      "enabled": true,
      "notes": "REASONIX_HOME=apps/pentest/.reasonix-home；启动后需 POST /tool-approval-mode {mode:auto}（dev-up 自动执行）。"
    },
    {
      "id": "pentest-adapter",
      "group": "pentest",
      "role": "adapter",
      "kind": "http",
      "cwd": "apps/pentest",
      "cmd": ["python", ".adapter.py"],
      "envFile": "config/env/pentest.env",
      "port": 8786,
      "baseUrl": "http://127.0.0.1:8786",
      "health": { "path": "/status", "expect": 200, "auth": "none" },
      "dependsOn": ["pentest-serve"],
      "startOrder": 21,
      "enabled": true,
      "notes": "大脑 registry 里 pentest 指向此端口；对外协议 /submit /status /events。"
    },
    {
      "id": "logaudit-serve",
      "group": "logaudit",
      "role": "engine",
      "kind": "http",
      "cwd": "apps/logaudit",
      "cmd": ["${REASONIX_BIN}", "serve", "--addr", "127.0.0.1:${LOGAUDIT_PORT}", "--auth", "token", "--token", "${LOGAUDIT_SERVE_TOKEN}", "--behind-proxy"],
      "envFile": "config/env/logaudit.env",
      "extraEnvFiles": ["apps/logaudit/.serve-home/.env"],
      "port": 8788,
      "baseUrl": "http://127.0.0.1:8788",
      "health": { "path": "/status", "expect": 200, "auth": "cookie", "cookieName": "reasonix_token", "cookieVar": "LOGAUDIT_SERVE_TOKEN" },
      "postStart": { "path": "/tool-approval-mode", "method": "POST", "cookieVar": "LOGAUDIT_SERVE_TOKEN", "body": { "mode": "auto" } },
      "preflightFiles": ["./bin/reasonix"],
      "dependsOn": [],
      "startOrder": 30,
      "enabled": true,
      "notes": "现网采用 serve 直连 8788（LOG_AUDIT_DEPLOYMENT.md）。若要改回 adapter 前置：LOGAUDIT_PORT=18788，另加 logaudit-adapter 服务并把 registry 指向 adapter。"
    },
    {
      "id": "intel-serve",
      "group": "intel",
      "role": "engine",
      "kind": "http",
      "cwd": "apps/intel/intel-agent",
      "cmd": ["${REASONIX_BIN}", "serve", "--addr", "127.0.0.1:${INTEL_RIX_PORT}", "--auth", "token", "--token", "${INTEL_SERVE_TOKEN}"],
      "envFile": "config/env/intel.env",
      "extraEnvFiles": ["apps/intel/intel-agent/.reasonix-home/.env"],
      "port": 8089,
      "baseUrl": "http://127.0.0.1:8089",
      "health": { "path": "/status", "expect": 200, "auth": "cookie", "cookieName": "reasonix_token", "cookieVar": "INTEL_SERVE_TOKEN" },
      "postStart": { "path": "/tool-approval-mode", "method": "POST", "cookieVar": "INTEL_SERVE_TOKEN", "body": { "mode": "yolo" } },
      "preflightFiles": ["./bin/reasonix"],
      "dependsOn": [],
      "startOrder": 40,
      "enabled": true,
      "notes": "REASONIX_HOME=apps/intel/intel-agent/.reasonix-home；intel 域启动后切 tool-approval-mode=yolo（run-serve.sh 原逻辑）。"
    },
    {
      "id": "intel-adapter",
      "group": "intel",
      "role": "adapter",
      "kind": "http",
      "cwd": "apps/intel/intel-agent",
      "cmd": ["python", "adapter.py"],
      "envFile": "config/env/intel.env",
      "port": 8789,
      "baseUrl": "http://127.0.0.1:8789",
      "health": { "path": "/status", "expect": 200, "auth": "none" },
      "dependsOn": ["intel-serve"],
      "startOrder": 41,
      "enabled": true,
      "notes": "大脑 registry 里 intel 指向此端口。"
    },
    {
      "id": "brain",
      "group": "brain",
      "role": "orchestrator",
      "kind": "http",
      "cwd": "apps/brain",
      "cmd": ["python", "-m", "api.main"],
      "envFile": "config/env/brain.env",
      "port": 6657,
      "baseUrl": "http://127.0.0.1:6657",
      "health": { "path": "/api/health", "expect": 200, "auth": "none" },
      "dependsOn": ["tir"],
      "startOrder": 50,
      "enabled": true,
      "notes": "对外统一入口：前端所有 /aisoc-*/api 都打到 6657；部件经 config/registry/brain.registry.json 注册。"
    },
    {
      "id": "frontend",
      "group": "frontend",
      "role": "ui",
      "kind": "http",
      "cwd": "apps/frontend",
      "cmd": ["python", "serve_frontend.py"],
      "envFile": "config/env/frontend.env",
      "port": 3000,
      "baseUrl": "http://127.0.0.1:3000",
      "health": { "path": "/", "expect": 200, "auth": "none" },
      "dependsOn": ["brain"],
      "startOrder": 60,
      "enabled": true,
      "notes": "静态 dist + 反向代理（/aisoc-*/api → 6657，/adapter-*/events → 各 adapter）。需先 cd apps/frontend/desktop/frontend && pnpm build。"
    },
    {
      "id": "frontend-dev",
      "group": "frontend",
      "role": "ui",
      "kind": "http",
      "cwd": "apps/frontend/desktop/frontend",
      "cmd": ["pnpm", "dev"],
      "envFile": "config/env/frontend.env",
      "port": 5173,
      "baseUrl": "http://127.0.0.1:5173",
      "health": { "path": "/", "expect": 200, "auth": "none" },
      "dependsOn": ["brain"],
      "startOrder": 61,
      "enabled": false,
      "notes": "开发态用 vite 代理（vite.config.ts 已把 5 个域全指向 6657）。与 frontend(3000) 二选一。"
    }
  ],
  "flows": [
    {
      "name": "单域任务（以 logaudit 为例）",
      "path": "frontend → brain:6657 POST /api/tasks → registry[logaudit]=8788 POST /submit → SSE /events → brain 轮询 /status → 回收 Finding → 落库/判定/报告 → frontend SSE /api/stream"
    },
    {
      "name": "多阶段管道（data_leak）",
      "path": "logaudit Finding → brain orchestrator 二次下发 pentest:8786 → pentest 回 Finding → brain 判定 real_threat → TIR:8090 /api/tir/ingest → 预案 → 前端批准 → /api/tir/playbooks/{id}/decision → 报告"
    }
  ]
}
