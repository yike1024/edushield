# ============================================================================
# 原则：环境变量（可能含密钥）与运行产物一律不进库；源码、模板、样例进库
# ============================================================================

# ---- 环境变量 / 密钥 ----
.env
.env.*
!.env.example
!*.env.example
# 前端仓库自带的公开默认值（只有 VITE_ 前缀）
!apps/frontend/desktop/frontend/.env
config/env/shared.env
config/env/*.env
# 由 .tmpl 渲染，含真实 token
config/registry/brain.registry.json

# ---- 运行日志 / 进程状态 ----
logs/
!logs/.gitkeep
.run/
*.log
!apps/**/logaudit.example.toml

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / 前端 ----
node_modules/
apps/frontend/desktop/frontend/dist/
apps/frontend/desktop/frontend/sourcemaps/
apps/frontend/desktop/frontend/.env.local

# ---- Go 构建产物（各域自己 build 出的 reasonix 二进制）----
apps/*/bin/reasonix
apps/*/bin/reasonix.exe
apps/*/bin/*.test
apps/*/.tools/
apps/*/gomodcache/
apps/*/gocache/

# ---- 运行时数据（可随时删掉重建）----
apps/brain/data/brain.sqlite3
apps/brain/data/attachments/
apps/brain/chroma_data/
apps/tir/storage/data/
apps/tir/storage/logs/
apps/logaudit/.serve-home/
apps/logaudit/logaudit-workdir/
apps/pentest/.reasonix-state/
apps/intel/intel-agent/.reasonix-state/
# 该样例被 Windows Defender 判定拦截，git 无法读取索引，暂不入库
apps/brain/data/samples/xdr_alerts_sample.json

# ---- 平台杂项 ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
!.vscode/extensions.json
